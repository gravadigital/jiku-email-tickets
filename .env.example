# --- Bus de Jiku (leidas por loadConfig() del SDK) ---
JIKU_CREDS=              # REQUERIDA. Ruta al archivo creds del sentinel de NATS (montado read-only)
JIKU_KEY_FILE=           # REQUERIDA. Ruta a la key JSON del machine user (montada read-only)
JIKU_PROJECT_ID=         # REQUERIDA. Project de ZITADEL (UUID). Sin el, el token no lleva roles
JIKU_INSTANCE=           # opcional, default: dev. Primer segmento del subject
JIKU_SERVERS=            # opcional, default: nats://localhost:4222
JIKU_ISSUER=             # opcional, default: https://id.grava.io
JIKU_TIMEOUT=            # opcional, default: 15000 (ms). Piso de 15000: valores menores se elevan

# --- Propias del conector ---
LOG_LEVEL=               # opcional, default: info. trace|debug|info|warn|error|fatal|silent
NODE_ENV=                # opcional, default: production. development|test|production
                         # Solo `development` activa pino-pretty; cualquier otro valor emite JSON.
                         # El default es production a proposito: el modo bonito se pide explicito

# --- Casilla IMAP (propias del conector) ---
IMAP_HOST=               # REQUERIDA. Host del servidor IMAP de la casilla de tickets
IMAP_PORT=               # opcional, default: 993 (IMAPS). Entero entre 1 y 65535
IMAP_USER=               # REQUERIDA. Usuario de la casilla
IMAP_PASSWORD=           # REQUERIDA. App Password de la casilla, NO la password de la cuenta.
                         # Llega por entorno: no se hornea en la imagen (NFR-S05)

# NO hay variable de carpeta, y la ausencia es una decision, no un olvido: en v1 la carpeta es
# INBOX, fija y no configurable. Vive como constante del modulo de ingesta.

# --- Poll (comportamiento del tick) ---
POLL_CRON=               # opcional, default: */5 * * * *. Se valida con cron.validate() de
                         # node-cron EN EL ARRANQUE: una expresion mal formada no arranca
POLL_ENABLED=            # opcional, default: true. Solo 'true' o 'false' literales; cualquier
                         # otro valor NO arranca. Las de IMAP siguen siendo requeridas con false
POLL_MAX_PER_TICK=       # opcional, default: 50. Maximo de mails por tick. Minimo 1

# --- Ruteo: el Mapa de Tickets, el prefijo y los placeholders ---
#
# EL MAPA DE TICKETS YA NO ES UNA VARIABLE (REQ-005 / S-025, REQ-008 / S-032).
#
# Vivia aca como TICKET_MAP / TICKET_MAP_FILE y se leia UNA sola vez al arrancar, asi que agregar
# un proyecto exigia editar la variable y REDESPLEGAR el contenedor. Ahora son claves del Espacio KV
# del conector (su porcion del bucket JIKU_KV del bus), con la CLAVE COMPLETA y EN MINUSCULAS:
#
#   nats kv put JIKU_KV <instance>.<sub>.tickets.<slug> <projectId>
#
# <instance>.<sub>. es el campo kvPrefix de la linea "espacio KV abierto" del arranque, copiado tal
# cual. Un put vale desde el mail siguiente, sin redeploy. Como operarlo, y la precondicion de que
# JIKU_KV exista con sus grants: precondicion 8 del README (seccion "Desplegar").

SUBADDRESS_PREFIX=       # opcional, default: tickets. El prefijo del subaddress del que se extrae
                         # el slug (tickets+alfa@dominio). La casilla tiene que aceptar subaddress
PLACEHOLDER_TITLE=       # opcional, default: Ticket recibido por mail. Titulo del requisito
                         # cuando el mail llega sin asunto
PLACEHOLDER_BODY=        # opcional, default: (mail sin contenido). Cuerpo del requisito cuando el
                         # mail llega sin contenido

# --- Politica local de archivos (adjuntos) ---
ATTACHMENT_ALLOWED_EXTENSIONS=  # opcional, default: .png,.jpg,.jpeg,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.log,.zip
ATTACHMENT_ALLOWED_MIME_TYPES=  # opcional, default: la lista MIME correspondiente a las extensiones de arriba
ATTACHMENT_MAX_SIZE_BYTES=      # opcional, default: 10485760 (10 MB). Entero positivo, en BYTES
PUT_TIMEOUT_MS=                 # opcional, default: 30000 (ms). NO se usa en S-017; lo consume S-019

# --- Carga de este archivo ---------------------------------------------------
#
# NO SE DECLARA ACA (seria circular: se lee para decidir si se lee este archivo). Va en el
# ENTORNO REAL, y existe para un solo caso: apagar la carga del `.env` sin mentir sobre el
# NODE_ENV del proceso.
#
#   DOTENV_DISABLED=true    los entry points NO cargan ningun `.env`
#
# El otro interruptor es NODE_ENV=test, que hace lo mismo. Los dos existen porque son dos
# preguntas distintas —"que soy" y "cargo el archivo"— y hay casos que necesitan declarar
# un NODE_ENV propio sin reactivar la carga (ver src/config/dotenv.ts).
#
# EN PRODUCCION NO HACE FALTA NINGUNO: la imagen no lleva `.env` y la configuracion entra
# por variables de entorno del orquestador. Es una herramienta para correr los tests y
# para depurar en local con un `.env` presente en el disco.

# --- Solo para `npm run verify` ----------------------------------------------
#
# ESTA VARIABLE NO LA LEE EL WORKER, y por eso va comentada y en su propio bloque al
# final: `npm run start` arranca sin ella, y un despliegue que solo corre el worker no
# tiene por que declarar un proyecto de prueba que nunca va a usar.
#
# La lee UN SOLO consumidor, el script `npm run verify`, que publica un requisito real
# para confirmar que el plano de escritura esta abierto (la key, el rol y core). Si vas a
# correrlo, descomentala; si falta, verify sale distinto de cero nombrandola.
#
# ES UN ENTERO DE LA BASE DE JIKU (una fila de proyectos), NO el project id de Zitadel de
# JIKU_PROJECT_ID. Los dos se llaman "project id" y son cosas distintas: aquel es un UUID
# de Zitadel y este es un int de Jiku, de la misma familia que los valores del Mapa de Tickets.
#
# Declarada, se valida igual que siempre (entero positivo): lo que se relajo es la
# PRESENCIA, nunca el VALOR.
#
# USA UN PROYECTO DE PRUEBA: cada corrida deja un requisito permanente, que no se modifica
# ni se borra nunca, y el conector no tiene comando de compensacion.
# JIKU_VERIFY_PROJECT_ID=

# --- KV de NATS: el Espacio KV del conector (REQ-008) ---
#
# No hay nada que configurar aca. El bucket es JIKU_KV, fijo en el SDK, y lo crea el deploy de
# Jiku: ni U-02 ni el conector lo crean. Que exista con allow_direct y sin TTL, y que la plantilla
# de internal-app tenga los tres grants del Espacio KV, es la precondicion 8 del README.
#
# VARIABLES ELIMINADAS (REQ-008 / S-032): las cuatro que configuraban los dos buckets
# (KV_TICKETS_BUCKET, KV_THREADS_BUCKET, KV_THREADS_TTL_DAYS y KV_WATCH_RETRY_MS) ya no existen.
# El estado vive en el Espacio KV del conector, dentro del bucket JIKU_KV que crea el deploy de
# Jiku, y no tiene nada configurable. Si alguna quedo declarada en el entorno, se ignora: no hace
# fallar el arranque ni cambia ningun comportamiento.
