# --- Bus de Jiku (leidas por loadConfig() del SDK) ---
JIKU_CREDS=              # REQUERIDA. Ruta al archivo creds del sentinel de NATS (montado read-only)
JIKU_KEY_FILE=           # REQUERIDA. Ruta a la key JSON del machine user (montada read-only)
JIKU_PROJECT_ID=         # REQUERIDA. Project de ZITADEL (UUID). Sin el, el token no lleva roles
JIKU_INSTANCE=           # opcional, default: dev. Primer segmento del subject
JIKU_SERVERS=            # opcional, default: nats://localhost:4222
JIKU_ISSUER=             # opcional, default: https://id.grava.io
JIKU_TIMEOUT=            # opcional, default: 15000 (ms). Piso de 15000: valores menores se elevan

# --- Propias del conector ---
JIKU_VERIFY_PROJECT_ID=  # REQUERIDA. Proyecto de JIKU (entero) donde `npm run verify` crea el
                         # requisito de prueba. NO es JIKU_PROJECT_ID: aquel es el project de
                         # Zitadel (UUID) y este es una fila de la base de Jiku (int)
LOG_LEVEL=               # opcional, default: info. trace|debug|info|warn|error|fatal|silent
NODE_ENV=                # opcional, default: production. development|test|production
                         # Solo `development` activa pino-pretty; cualquier otro valor emite JSON.
                         # El default es production a proposito: el modo bonito se pide explicito
