{
  "name": "jiku-mail-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#config/*": "./dist/config/*",
    "#domain/*": "./dist/domain/*",
    "#infra/*": "./dist/infra/*",
    "#shared/*": "./dist/shared/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "verify": "node --input-type=module -e \"console.error('El modo de verificacion se implementa en S-005.'); process.exit(1);\"",
    "test": "vitest run",
    "test:teardown": "vitest run && node scripts/verify-teardown.mjs"
  },
  "dependencies": {
    "@gravadigital/jiku": "^1.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "testcontainers": "^12.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
