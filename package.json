{
  "name": "jiku-email-tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#config/*": "./dist/config/*",
    "#domain/*": "./dist/domain/*",
    "#infra/*": "./dist/infra/*",
    "#shared/*": "./dist/shared/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "verify": "node dist/verify.js",
    "test": "vitest run",
    "test:teardown": "vitest run && node scripts/verify-teardown.mjs"
  },
  "dependencies": {
    "@gravadigital/jiku": "^1.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.17",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
